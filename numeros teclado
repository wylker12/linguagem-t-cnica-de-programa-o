#include <stdio.h>

int main() {
    int numeros[10];
    int maior, menor;
    int i;

    // Leitura dos 10 números
    for (i = 0; i < 10; i++) {
        printf("Digite o %d numero: ", i + 1);
        scanf("%d", &numeros[i]);
    }

    // Inicializa com os valores corretos
    maior = numeros[0];
    menor = numeros[5];

    // Procura o maior entre os 5 primeiros
    for (i = 1; i < 5; i++) {
        if (numeros[i] > maior) {
            maior = numeros[i];
        }
    }

    // Procura o menor entre os 5 últimos
    for (i = 6; i < 10; i++) {
        if (numeros[i] < menor) {
            menor = numeros[i];
        }
    }
